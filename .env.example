# Copy this file to .env and replace the placeholder values. .env is not in git.
# Docker Compose (deploy/compose.yaml) reads .env. ATrade reads only environment variables.

# PostgreSQL password. Use only letters, digits, and "-": the value goes into a connection URL.
ATRADE_POSTGRES_PASSWORD=change-me-postgres-password

# "paper" or "live". "live" stops the start in this stage.
ATRADE_TRADING_MODE=paper

# Host address and port of the web service. Keep 127.0.0.1 on a development machine.
# On the server, set the Tailscale IP address of the server. The reverse proxy (Nginx Proxy Manager)
# connects to it through Tailscale (docs/architecture.md section 14).
ATRADE_WEB_BIND_ADDRESS=127.0.0.1
ATRADE_WEB_PORT=8000

# Memory limit of the web container (Docker size, for example 4g).
# 0 turns the limit off. Use 0 only when the container runtime cannot set memory limits,
# for example rootless Podman without the memory cgroup controller.
ATRADE_WEB_MEMORY_LIMIT=4g

# Memory limit of the assistant container (the AI assistant, Docker size, for example 1g).
# Only Compose reads it. The assistant process does not get it. 0 turns the limit off, as above.
ATRADE_ASSISTANT_MEMORY_LIMIT=1g

# Optional Compose services. "ibkr" starts the ib-gateway service (IB Gateway logged in to the
# IBKR paper account). Without it, ATrade starts and the UI shows "IB Gateway not reachable".
COMPOSE_PROFILES=

# IBKR paper account login for the ib-gateway service. Only ib-gateway gets these values.
ATRADE_IBKR_USERNAME=change-me-ibkr-paper-username
ATRADE_IBKR_PASSWORD=change-me-ibkr-paper-password

# Daily restart of IB Gateway through IBC, without a new login. Format "hh:mm AM" or "hh:mm PM",
# in the time zone below. Keep it before the daily IBKR server reset.
ATRADE_IBKR_AUTO_RESTART_TIME=11:45 PM
ATRADE_IBKR_TIME_ZONE=America/New_York

# Expected IBKR paper account number, for example DU1234567. Empty means not configured.
ATRADE_IBKR_ACCOUNT_ID=

# Where the web process connects to IB Gateway. Inside the Compose network, the paper API is ib-gateway:4004.
ATRADE_IBKR_HOST=ib-gateway
ATRADE_IBKR_PAPER_PORT=4004

# IBKR client IDs. Each process uses a different client ID. 0 and multiples of 1000 are not allowed.
# The web process uses one fixed ID. Forward tests take IDs from the range first-last.
ATRADE_IBKR_WEB_CLIENT_ID=1
ATRADE_FORWARD_TEST_CLIENT_ID_FIRST=10
ATRADE_FORWARD_TEST_CLIENT_ID_LAST=13

# Paper capital in USD when no paper account balance is available.
ATRADE_LOCAL_PAPER_CAPITAL_USD=100000
