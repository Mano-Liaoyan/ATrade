{
  "openapi": "3.1.0",
  "info": {
    "title": "ATrade",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Read Health",
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/ibkr/gateway": {
      "get": {
        "summary": "Read Gateway Status",
        "operationId": "read_gateway_status_api_ibkr_gateway_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/market-data/instrument-search": {
      "get": {
        "summary": "Search Instruments",
        "operationId": "search_instruments_api_market_data_instrument_search_get",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "\\S",
              "title": "Query"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentSearchResponse"
                }
              }
            }
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Bad Gateway"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/strategies": {
      "get": {
        "summary": "List Strategies",
        "operationId": "list_strategies_api_strategies_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/StrategyListItem"
                  },
                  "type": "array",
                  "title": "Response List Strategies Api Strategies Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create Strategy",
        "operationId": "create_strategy_api_strategies_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateStrategyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/strategies/{strategy_id}": {
      "get": {
        "summary": "Read Strategy",
        "operationId": "read_strategy_api_strategies__strategy_id__get",
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Strategy Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete Strategy",
        "operationId": "delete_strategy_api_strategies__strategy_id__delete",
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Strategy Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/strategies/{strategy_id}/versions/{version_number}": {
      "get": {
        "summary": "Read Version",
        "operationId": "read_version_api_strategies__strategy_id__versions__version_number__get",
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Strategy Id"
            }
          },
          {
            "name": "version_number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Version Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyVersionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/strategies/{strategy_id}/versions": {
      "post": {
        "summary": "Save Version",
        "description": "Checks the code first. Then it appends a version, or returns the latest version when the code is the same.",
        "operationId": "save_version_api_strategies__strategy_id__versions_post",
        "parameters": [
          {
            "name": "strategy_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Strategy Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveVersionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyVersionResponse"
                }
              }
            }
          },
          "200": {
            "description": "The code is the same as the latest version. No new version is made.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StrategyVersionResponse"
                }
              }
            }
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CodeCheckFailedResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        }
      }
    },
    "/api/watchlist": {
      "get": {
        "summary": "List Instruments",
        "operationId": "list_instruments_api_watchlist_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add Instrument",
        "description": "Checks the instrument through market_data first, so the watchlist holds only instruments that IBKR knows.",
        "operationId": "add_instrument_api_watchlist_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddInstrumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistInstrumentResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/watchlist/{watchlist_instrument_id}": {
      "delete": {
        "summary": "Delete Instrument",
        "operationId": "delete_instrument_api_watchlist__watchlist_instrument_id__delete",
        "parameters": [
          {
            "name": "watchlist_instrument_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Watchlist Instrument Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchlistErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddInstrumentRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Symbol"
          },
          "exchange": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Exchange"
          },
          "currency": {
            "type": "string",
            "maxLength": 8,
            "minLength": 1,
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "exchange",
          "currency"
        ],
        "title": "AddInstrumentRequest"
      },
      "CodeCheckFailedResponse": {
        "properties": {
          "problems": {
            "items": {
              "$ref": "#/components/schemas/CodeProblemResponse"
            },
            "type": "array",
            "title": "Problems"
          }
        },
        "type": "object",
        "required": [
          "problems"
        ],
        "title": "CodeCheckFailedResponse"
      },
      "CodeProblemResponse": {
        "properties": {
          "line": {
            "type": "integer",
            "title": "Line"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "line",
          "message"
        ],
        "title": "CodeProblemResponse"
      },
      "CreateStrategyRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateStrategyRequest"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "GatewayStatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "connected",
              "unreachable"
            ],
            "title": "Status"
          },
          "host": {
            "type": "string",
            "title": "Host"
          },
          "port": {
            "type": "integer",
            "title": "Port"
          }
        },
        "type": "object",
        "required": [
          "status",
          "host",
          "port"
        ],
        "title": "GatewayStatusResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database"
          },
          "time_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Time Utc"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "time_utc"
        ],
        "title": "HealthResponse"
      },
      "InstrumentResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "exchange": {
            "type": "string",
            "title": "Exchange"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "exchange",
          "currency"
        ],
        "title": "InstrumentResponse"
      },
      "InstrumentSearchResponse": {
        "properties": {
          "instruments": {
            "items": {
              "$ref": "#/components/schemas/InstrumentResponse"
            },
            "type": "array",
            "title": "Instruments"
          }
        },
        "type": "object",
        "required": [
          "instruments"
        ],
        "title": "InstrumentSearchResponse"
      },
      "SaveVersionRequest": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          }
        },
        "type": "object",
        "required": [
          "code"
        ],
        "title": "SaveVersionRequest"
      },
      "StrategyListItem": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "latest_version_number": {
            "type": "integer",
            "title": "Latest Version Number"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "latest_version_number"
        ],
        "title": "StrategyListItem"
      },
      "StrategyResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Created At Utc"
          },
          "versions": {
            "items": {
              "$ref": "#/components/schemas/StrategyVersionSummary"
            },
            "type": "array",
            "title": "Versions"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at_utc",
          "versions"
        ],
        "title": "StrategyResponse"
      },
      "StrategyVersionResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "strategy_id": {
            "type": "integer",
            "title": "Strategy Id"
          },
          "version_number": {
            "type": "integer",
            "title": "Version Number"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "code_sha256": {
            "type": "string",
            "title": "Code Sha256"
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Created At Utc"
          }
        },
        "type": "object",
        "required": [
          "id",
          "strategy_id",
          "version_number",
          "code",
          "code_sha256",
          "created_at_utc"
        ],
        "title": "StrategyVersionResponse"
      },
      "StrategyVersionSummary": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "version_number": {
            "type": "integer",
            "title": "Version Number"
          },
          "code_sha256": {
            "type": "string",
            "title": "Code Sha256"
          },
          "created_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Created At Utc"
          }
        },
        "type": "object",
        "required": [
          "id",
          "version_number",
          "code_sha256",
          "created_at_utc"
        ],
        "title": "StrategyVersionSummary"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WatchlistErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "WatchlistErrorResponse"
      },
      "WatchlistInstrumentResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "exchange": {
            "type": "string",
            "title": "Exchange"
          },
          "currency": {
            "type": "string",
            "title": "Currency"
          },
          "added_at_utc": {
            "type": "string",
            "format": "date-time",
            "title": "Added At Utc"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "exchange",
          "currency",
          "added_at_utc"
        ],
        "title": "WatchlistInstrumentResponse"
      },
      "WatchlistResponse": {
        "properties": {
          "instruments": {
            "items": {
              "$ref": "#/components/schemas/WatchlistInstrumentResponse"
            },
            "type": "array",
            "title": "Instruments"
          }
        },
        "type": "object",
        "required": [
          "instruments"
        ],
        "title": "WatchlistResponse"
      }
    }
  }
}
