{
  "name": "atrade-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "imports": {
    "#lib/*": "./src/lib/*/index.ts"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "check:svelte": "svelte-kit sync && svelte-check --fail-on-warnings",
    "lint:eslint": "svelte-kit sync && eslint .",
    "test:e2e": "playwright test",
    "generate:api": "uv run --directory ../backend python -m atrade.app.openapi_document ../frontend/src/lib/api/openapi.json && openapi-typescript src/lib/api/openapi.json --output src/lib/api/index.ts",
    "check:api": "openapi-typescript src/lib/api/openapi.json --output src/lib/api/index.ts --check"
  },
  "devDependencies": {
    "@carbon/colors": "11.61.0",
    "@carbon/icons": "11.91.0",
    "@carbon/styles": "1.118.0",
    "@carbon/themes": "11.84.0",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lsp-client": "6.3.0",
    "@codemirror/merge": "6.12.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@eslint/js": "10.0.1",
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@internationalized/date": "3.12.4",
    "@lezer/highlight": "1.2.5",
    "@pierre/diffs": "1.6.2",
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-static": "4.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.5",
    "bits-ui": "2.20.2",
    "codemirror": "6.0.2",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "lightweight-charts": "5.2.1",
    "marked": "18.1.2",
    "openapi-typescript": "7.13.0",
    "pele": "1.12.0",
    "sass-embedded": "1.106.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1"
  }
}
